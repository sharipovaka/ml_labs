{
  "name": "ml-seminars",
  "version": "1.0.0",
  "private": true,
  "description": "SPA для публикации материалов семинаров по машинному обучению (React + Bootstrap 5 + Webpack)",
  "homepage": "https://sharipovaka.github.io/mltest1/",
  "license": "MIT",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "convert": "bash scripts/convert-notebooks.sh",
    "test": "node scripts/smoke-test.js",
    "icons": "python3 scripts/make-icons.py",
    "predeploy": "npm test && npm run build",
    "deploy": "gh-pages -d dist -b gh-pages -t"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bootstrap": "^5.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "gh-pages": "^6.2.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  },
  "browserslist": [
    ">0.3%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": ">=18"
  }
